rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Uppskriftir: Lesanlegar öllum, skrifanlegar eiganda
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.author_uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Veitingastaðir: Lesanlegt öllum, skrif admin
    match /restaurants/{restId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      match /menu_items/{itemId} {
        allow read: if true;
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
    }

    // Matseðilsatriði (top-level): Les öllum, skrif admin
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Reviews: Les öllum, skrif innskráðum
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.author_uid;
    }

    // Users: Stakt skjal lesanlegt öllum (opinberar prófílsíður þurfa það), en
    // EKKI listun á safninu — annars getur hver sem er sótt öll netföng.
    //
    // `role` er ALDREI skrifanlegt af notandanum sjálfum. Allar admin-reglur hér að
    // neðan gæta á þessu felti, svo ef notandi gæti sett það á sig sjálfur væri
    // hver innskráður notandi orðinn kerfisstjóri. Hlutverk er sett handvirkt í
    // Firebase Console.
    match /users/{uid} {
      allow get: if true;
      allow list: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if request.auth.uid == uid &&
        !('role' in request.resource.data);
      allow update: if request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if false;
    }

    // Likes, follows: Eigandi
    match /likes/{likeId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == request.resource.data.user_uid;
    }
    match /follows/{followId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }

    // Auglýsingar: Les öllum, skrif admin, teljarar opnir
    match /ads/{adId} {
      allow read: if true;
      // Allow anyone to increment impressions/clicks counters
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks']);
      allow create, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Admin can update any field
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Ad events: Skrif öllum (API route), les admin
    match /ad_events/{eventId} {
      allow create: if true;   // API route skrifar
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Ad daily stats: Les/skrif admin
    match /ad_daily_stats/{statId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Categories: Les öllum, skrif admin
    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
